generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  OPERATIONS
  FINANCE
  SUPPORT
  ADMIN
}

enum OrderStatus {
  NEW
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
}

enum ShipmentStatus {
  CREATED
  READY_FOR_PICKUP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
}

enum TransactionType {
  ORDER_CAPTURE
  REFUND
  ADJUSTMENT
  PAYOUT
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum WebhookEventType {
  ORDER_CREATED
  ORDER_UPDATED
  SHIPMENT_UPDATED
  SETTLEMENT_COMPLETED
  PAYOUT_FAILED
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  DEAD_LETTER
}

enum AnalyticsEventType {
  PRODUCT_VIEW
  ADD_TO_CART
  AFFILIATE_CLICK
  REDIRECT
  SEARCH
}

enum MediaJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Seller {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  stores      Store[]
  users       User[]
  products    Product[]
  skus        Sku[]
  orders      Order[]
  shipments   Shipment[]
  transactions Transaction[]
  settlements Settlement[]
  auditLogs   AuditLog[]
  webhookEndpoints WebhookEndpoint[]
  webhookEvents WebhookEvent[]
  reconciliationReports ReconciliationReport[]
  analyticsEvents AnalyticsEvent[]
  mediaJobs MediaJob[]
}

model Store {
  id        String    @id @default(uuid()) @db.Uuid
  sellerId  String @db.Uuid
  name      String
  slug      String
  currency  String    @default("INR")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  seller    Seller    @relation(fields: [sellerId], references: [id])
  users       User[]
  products    Product[]
  skus        Sku[]
  orders      Order[]
  shipments   Shipment[]
  transactions Transaction[]
  settlements Settlement[]
  auditLogs   AuditLog[]
  webhookEndpoints WebhookEndpoint[]
  webhookEvents WebhookEvent[]
  reconciliationReports ReconciliationReport[]
  analyticsEvents AnalyticsEvent[]
  mediaJobs MediaJob[]

  @@unique([sellerId, slug])
  @@index([sellerId, deletedAt])
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  sellerId     String @db.Uuid
  storeId      String @db.Uuid
  email        String
  passwordHash String
  role         Role
  permissions  String[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  seller       Seller    @relation(fields: [sellerId], references: [id])
  store        Store     @relation(fields: [storeId], references: [id])
  auditLogs    AuditLog[]

  @@unique([sellerId, storeId, email])
  @@index([sellerId, storeId, role])
}

model Product {
  id          String    @id @default(uuid()) @db.Uuid
  sellerId    String @db.Uuid
  storeId     String @db.Uuid
  name        String
  description String?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  seller      Seller    @relation(fields: [sellerId], references: [id])
  store       Store     @relation(fields: [storeId], references: [id])
  skus        Sku[]

  @@index([sellerId, storeId, status])
  @@index([sellerId, storeId, deletedAt])
}

model Sku {
  id          String    @id @default(uuid()) @db.Uuid
  sellerId    String @db.Uuid
  storeId     String @db.Uuid
  productId   String @db.Uuid
  code        String
  price       Int
  inventory   Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  seller      Seller    @relation(fields: [sellerId], references: [id])
  store       Store     @relation(fields: [storeId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([sellerId, storeId, code])
  @@index([sellerId, storeId, productId])
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  sellerId    String @db.Uuid
  storeId     String @db.Uuid
  orderNumber String
  status      OrderStatus @default(NEW)
  totalAmount Int
  version     Int         @default(1)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  seller      Seller      @relation(fields: [sellerId], references: [id])
  store       Store       @relation(fields: [storeId], references: [id])
  shipments   Shipment[]
  transactions Transaction[]
  settlements Settlement[]

  @@unique([sellerId, storeId, orderNumber])
  @@index([sellerId, storeId, status, createdAt])
}

model Shipment {
  id         String         @id @default(uuid()) @db.Uuid
  sellerId   String @db.Uuid
  storeId    String @db.Uuid
  orderId    String @db.Uuid
  status     ShipmentStatus @default(CREATED)
  carrier    String?
  awb        String?
  timeline   Json
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  seller     Seller         @relation(fields: [sellerId], references: [id])
  store      Store          @relation(fields: [storeId], references: [id])
  order      Order          @relation(fields: [orderId], references: [id])

  @@index([sellerId, storeId, status])
  @@index([orderId])
}

model Transaction {
  id             String          @id @default(uuid()) @db.Uuid
  sellerId       String @db.Uuid
  storeId        String @db.Uuid
  orderId        String? @db.Uuid
  settlementId   String? @db.Uuid
  type           TransactionType
  amount         Int
  currency       String          @default("INR")
  idempotencyKey String
  metadata       Json?
  createdAt      DateTime        @default(now())
  seller         Seller          @relation(fields: [sellerId], references: [id])
  store          Store           @relation(fields: [storeId], references: [id])
  order          Order?          @relation(fields: [orderId], references: [id])
  settlement     Settlement?     @relation(fields: [settlementId], references: [id])

  @@unique([sellerId, storeId, idempotencyKey])
  @@index([sellerId, storeId, type, createdAt])
}

model Settlement {
  id                  String           @id @default(uuid()) @db.Uuid
  sellerId            String @db.Uuid
  storeId             String @db.Uuid
  orderId             String? @db.Uuid
  status              SettlementStatus @default(PENDING)
  amount              Int
  payoutIdempotencyKey String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  settledAt           DateTime?
  seller              Seller           @relation(fields: [sellerId], references: [id])
  store               Store            @relation(fields: [storeId], references: [id])
  order               Order?           @relation(fields: [orderId], references: [id])
  transactions        Transaction[]

  @@unique([sellerId, storeId, payoutIdempotencyKey])
  @@index([sellerId, storeId, status, createdAt])
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  sellerId      String @db.Uuid
  storeId       String @db.Uuid
  userId        String? @db.Uuid
  entityType    String
  entityId      String
  action        String
  correlationId String
  metadata      Json?
  createdAt     DateTime @default(now())
  seller        Seller   @relation(fields: [sellerId], references: [id])
  store         Store    @relation(fields: [storeId], references: [id])
  user          User?    @relation(fields: [userId], references: [id])

  @@index([sellerId, storeId, entityType, entityId])
  @@index([createdAt])
}

model WebhookEndpoint {
  id        String   @id @default(uuid()) @db.Uuid
  sellerId  String   @db.Uuid
  storeId   String   @db.Uuid
  url       String
  secret    String
  events    WebhookEventType[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seller    Seller   @relation(fields: [sellerId], references: [id])
  store     Store    @relation(fields: [storeId], references: [id])
  deliveries WebhookDelivery[]

  @@index([sellerId, storeId, isActive])
}

model WebhookEvent {
  id            String           @id @default(uuid()) @db.Uuid
  sellerId      String           @db.Uuid
  storeId       String           @db.Uuid
  eventType     WebhookEventType
  entityId      String
  eventKey      String
  correlationId String
  payload       Json
  createdAt     DateTime         @default(now())
  seller        Seller           @relation(fields: [sellerId], references: [id])
  store         Store            @relation(fields: [storeId], references: [id])
  deliveries    WebhookDelivery[]

  @@unique([sellerId, storeId, eventKey])
  @@index([sellerId, storeId, eventType, createdAt])
}

model WebhookDelivery {
  id             String                @id @default(uuid()) @db.Uuid
  eventId        String                @db.Uuid
  endpointId     String                @db.Uuid
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  lastAttemptAt  DateTime?
  responseStatus Int?
  error          String?
  idempotencyKey String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  event          WebhookEvent          @relation(fields: [eventId], references: [id])
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id])

  @@unique([eventId, endpointId])
  @@unique([idempotencyKey])
  @@index([status, updatedAt])
}

model ReconciliationReport {
  id               String   @id @default(uuid()) @db.Uuid
  sellerId         String   @db.Uuid
  storeId          String   @db.Uuid
  runKey           String
  discrepancyCount Int
  summary          Json
  createdAt        DateTime @default(now())
  seller           Seller   @relation(fields: [sellerId], references: [id])
  store            Store    @relation(fields: [storeId], references: [id])

  @@unique([sellerId, storeId, runKey])
  @@index([sellerId, storeId, createdAt])
}

model AnalyticsEvent {
  id             String             @id @default(uuid()) @db.Uuid
  sellerId       String             @db.Uuid
  storeId        String             @db.Uuid
  eventType      AnalyticsEventType
  idempotencyKey String
  metadata       Json?
  createdAt      DateTime           @default(now())
  seller         Seller             @relation(fields: [sellerId], references: [id])
  store          Store              @relation(fields: [storeId], references: [id])

  @@unique([sellerId, storeId, idempotencyKey])
  @@index([sellerId, storeId, eventType, createdAt])
}

model MediaJob {
  id                String       @id @default(uuid()) @db.Uuid
  sellerId          String       @db.Uuid
  storeId           String       @db.Uuid
  sourceObjectKey   String
  destinationPrefix String
  status            MediaJobStatus @default(PENDING)
  attempts          Int          @default(0)
  error             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  seller            Seller       @relation(fields: [sellerId], references: [id])
  store             Store        @relation(fields: [storeId], references: [id])

  @@index([sellerId, storeId, status, createdAt])
}
